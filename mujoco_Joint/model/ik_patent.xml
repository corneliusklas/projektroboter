<mujoco>

<!-- 
Seilanker-Positionen (Sites) für ein Rolling-Contact-Gelenk
Radius: 20.5 mm = 0.0205 m
Z-Offset: -0.023 (Start), 0.0 (Ende)

Berechnung (im XY-Kreis, um Z):
x = R * cos(theta)
y = R * sin(theta)
Alle Winkel in Grad → Radiant: θ [rad] = θ [deg] * π / 180

Tendon-X Start:
-25° → x =  0.0186   y = -0.0087   z = -0.023  (gripper)
-15° → x =  0.0198   y = -0.0053   z = -0.023  
 -5° → x =  0.0204   y = -0.0018   z = -0.023  
 +5° → x =  0.0204   y =  0.0018   z = -0.023  
+15° → x =  0.0198   y =  0.0053   z = -0.023  

Tendon-Y Start:
+75°  → x =  0.0053   y =  0.0198   z = -0.023  
+85°  → x =  0.0018   y =  0.0204   z = -0.023  
+95°  → x = -0.0018   y =  0.0204   z = -0.023  
+105° → x = -0.0053   y =  0.0198   z = -0.023  

site_gri = '0.0186 0.0087'
site_x_1 = '0.0198 -0.0053'
site_x_2 = '0.0204 -0.0018'
site_x_3 = '0.0204  0.0018'
site_x_4 = '0.0198  0.0053'
site_y_1 = ' 0.0053  0.0198'
site_y_2 = ' 0.0018  0.0204'
site_y_3 = ' -0.0018 0.0204'
site_y_4 = ' -0.0053 0.0198'


-->

<!--
Tendon-Längen in Ausgangsstellung (Gelenkwinkel = 0)

Diese Seile enden auf unterschiedlichen Ebenen im Arm, je nach Routing-Tiefe.
Jedes Gelenk hat eine Länge von 46 mm.
Abstände:
  Schulter     → Ellenbogen1     = 107 mm
  Ellenbogen1  → Ellenbogen2     = 31 mm
  Ellenbogen2  → Handgelenk      = 107 mm

Tendon-Gruppen:
1. Seil → Schulter           = 0.046 m
2. Seil → Ellenbogen 1       = 0.199 m
3. Seil → Ellenbogen 2       = 0.276 m
4. Seil → Handgelenk         = 0.429 m
5. Seil → Hand (geschätzt)   = 0.479 m
-->

<!-- Default-Parameter für Geometrien -->
<default>
    <geom density="300"/>
</default>

<!-- Simulationsoptionen -->
<option gravity="0 0 0"/>
<!-- <option timestep="0.001" integrator="RK4"/> -->

<!-- Compiler- und Asset-Einstellungen -->
<compiler angle="radian" meshdir="." autolimits="true"/>
<asset>
    <!-- Optional: STL-Modelle hier einfügen -->
</asset>


<visual>
    <global
        fovy="2"          
        azimuth="135"     
        elevation="-35.264"/>
        <!-- isometrische Draufsicht --><!-- winziger Öffnungswinkel (°) --><!-- ≈ atan(1/√2) -->
</visual>


<worldbody>

    <camera name="iso_cam"
            pos="1 1 1"           
            euler="0 -35.264 135"       
            fovy="2"/>        


    <!-- Lichtquelle -->
    <light directional="true" pos="-0.5 0.5 3" dir="0 0 -1" />

    <!-- Boden (Tischplatte) -->
    <geom name="table" type="plane" pos="0 0 0" size="1 1 1" rgba="1 0.83 0.61 0.5"/>

    <!-- Orientierungshilfen (Achsen) -->
    <geom name="x-axis" type="box" size="0.04 0.01 0.01" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    <geom name="y-axis" type="box" size="0.01 0.04 0.01" rgba="0 1 0 1" contype="0" conaffinity="0"/>
    <geom name="z-axis" type="box" size="0.01 0.01 0.04" rgba="0 0 1 1" contype="0" conaffinity="0"/>

    <!-- ROBOT Körper -->
    <geom name="robot" type="box" size="0.05 0.1 0.2" pos="0 0.11 0.2" rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>

    <!-- ROBOT Kopf -->
    <geom name="head" type="box" size="0.05 0.04 0.07" pos="0 0.11 0.5" rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>

    <!-- ROBOT Augen -->
    <geom name="eye_left"  type="sphere" size="0.01" pos="0.05 0.09 0.5" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="eye_right" type="sphere" size="0.01" pos="0.05 0.13 0.5" rgba="1 1 1 1" contype="0" conaffinity="0"/>

	<!-- Rotate 90° around X axis and place the arm 40 cm above table surface -->
	<body name="arm_base" pos="0 0 0.4" euler="1.5708 0 0">
		<geom name="arm_base_geom" type="box" size="0.02 0.02 0.01" rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>

		<!-- Arm rotation around Z axis -->
		<body name="arm_rot" pos="0 0 0">
			<joint name="arm_z_joint" type="hinge" axis="0 0 1" pos="0 0 0" damping="0.01" range="-3.14 3.14"/>

			<!-- Base of shoulder joint after arm rotation-->
			<body name="shoulder_base" pos="0 0 0">
				<geom name="shoulder_base_geom" type="box" size="0.02 0.02 0.01" rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>

				<!-- Shoulder frame with tendon anchors -->
				<body name="shoulder_frame" pos="0 0 0.04">
					<geom name="shoulder_frame_x" type="box" size="0.003" fromto="-.035 0 -.023 .035 0 -.023" rgba="0 0 1 1" contype="0" conaffinity="0"/>
					<geom name="shoulder_frame_y" type="box" size="0.003" fromto="0 -.035 -.023 0 .035 -.023" rgba="0 0 1 1" contype="0" conaffinity="0"/>

					<!-- Tendon anchors (8 starts + 1 gripper) -->
					<site name="sh_tendon_gripper"        pos=" -0.0186 -0.0087  -0.023" size="0.005 "/>
					<site name="sh_tendon_x_start_1"      pos=" 0.0204 -0.0018  -0.023" size="0.005 "/>
					<site name="sh_tendon_x_start_2"      pos=" 0.0198 -0.0053  -0.023" size="0.005 "/>
					<site name="sh_tendon_x_start_3"      pos=" 0.0204  0.0018  -0.023" size="0.005 "/>
					<site name="sh_tendon_x_start_4"      pos=" 0.0198  0.0053  -0.023" size="0.005 "/>
					<site name="sh_tendon_y_start_1"      pos=" 0.0018  0.0204  -0.023" size="0.005 "/>
					<site name="sh_tendon_y_start_2"      pos=" 0.0053  0.0198  -0.023" size="0.005 "/>
					<site name="sh_tendon_y_start_3"      pos=" -0.0018 0.0204  -0.023" size="0.005 "/>
					<site name="sh_tendon_y_start_4"      pos=" -0.0053 0.0198  -0.023" size="0.005 "/>


                    <body name="shoulder_xjoint1" pos="0 0 0">
                        <geom name="shoulder_xjoint1" type="box" size=".005" fromto="-.02 0 -.023 .02 0 -.023" rgba="1 0 0 1" contype="0" conaffinity="0"/>
                        <joint name="shoulder_xjoint1" type="hinge" axis="1 0 0" pos="0 0 -.023" damping="0.02" range="-0.7854 0.7854"/>

                        <body name="shoulder_yjoint1" pos="0 0 0">
                            <geom name="shoulder_connector" type="box" size=".003" fromto="0 0 -.023 0 0 .023" rgba=".5 .5 .5 1" contype="0" conaffinity="0"/>
                            <geom name="shoulder_yjoint1" type="box" size=".006" fromto="0 0.02 -.023 0 -0.02 -.023" rgba="0 1 0 1" contype="0" conaffinity="0"/>
                            <joint name="shoulder_yjoint1" type="hinge" axis="0 1 0" pos="0 0 -.023" damping="0.02" range="-0.7854 0.7854"/>

                            <geom name="shoulder_yjoint2" type="box" size=".006" fromto="0 0.02 .023 0 -0.02 .023" rgba="0 1 0 1" contype="0" conaffinity="0"/>
