                                    <site name="sh_tendon_y_end_4"         pos=" -0.0053 0.0198  0.0" size="0.005"/>


                                    <!-- Connector between shoulder and elbow -->
                                    <geom name="link_shoulder_elbow1" type="capsule" fromto="0 0 0 0 0 0.107" size="0.01" rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>

                                    <!-- ELBOW JOINT 1 -->
                                    <body name="elbow1base" pos="0 0 0.13"> <!-- 0.107 + 0.023 = 0.13 -->
                                        <geom name="elbow1framex" type="box" size=".003" fromto="-.035 0 -.023 .035 0 -.023" rgba="0 0 1 1" contype="0" conaffinity="0"/>
                                        <geom name="elbow1framey" type="box" size=".003" fromto="0 -.035 -.023 0 .035 -.023" rgba="0 0 1 1" contype="0" conaffinity="0"/>
                                        <!-- Seilanker el1 (8 Startpunkte + 1* gripper) -->
                                        <site name="el1_tendon_gripper"     pos=" -0.0186 -0.0087  -0.023" size="0.005 "/>
                                        <site name="el1_tendon_x_start_1"   pos=" 0.0204 -0.0018  -0.023" size="0.005 "/>
                                        <site name="el1_tendon_x_start_2"   pos=" 0.0198 -0.0053  -0.023" size="0.005 "/>
                                        <site name="el1_tendon_x_start_3"   pos=" 0.0204  0.0018  -0.023" size="0.005 "/>
                                        <site name="el1_tendon_x_start_4"   pos=" 0.0198  0.0053  -0.023" size="0.005 "/>
                                        <site name="el1_tendon_y_start_1"   pos=" 0.0018  0.0204  -0.023" size="0.005 "/>
                                        <site name="el1_tendon_y_start_2"   pos=" 0.0053  0.0198  -0.023" size="0.005 "/>
                                        <site name="el1_tendon_y_start_3"   pos=" -0.0018 0.0204  -0.023" size="0.005 "/>
                                        <site name="el1_tendon_y_start_4"   pos=" -0.0053 0.0198  -0.023" size="0.005 "/>

