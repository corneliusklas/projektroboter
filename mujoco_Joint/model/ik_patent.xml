<equality>
    <!-- Couple the sub-joints of each rolling contact pair (X and Y) -->
    <joint joint1="shoulder_xjoint1" joint2="shoulder_xjoint2" polycoef="0 1 0 0 0" solref="0.002 0.5" solimp="0.95 0.98 0.001"/>
    <joint joint1="shoulder_yjoint1" joint2="shoulder_yjoint2" polycoef="0 1 0 0 0" solref="0.002 0.5" solimp="0.95 0.98 0.001"/>
    <joint joint1="elbow1_xjoint1"   joint2="elbow1_xjoint2"   polycoef="0 1 0 0 0" solref="0.002 0.5" solimp="0.95 0.98 0.001"/>
    <joint joint1="elbow1_yjoint1"   joint2="elbow1_yjoint2"   polycoef="0 1 0 0 0" solref="0.002 0.5" solimp="0.95 0.98 0.001"/>
    <joint joint1="elbow2_xjoint1"   joint2="elbow2_xjoint2"   polycoef="0 1 0 0 0" solref="0.002 0.5" solimp="0.95 0.98 0.001"/>
    <joint joint1="elbow2_yjoint1"   joint2="elbow2_yjoint2"   polycoef="0 1 0 0 0" solref="0.002 0.5" solimp="0.95 0.98 0.001"/>
    <joint joint1="wrist_xjoint1"    joint2="wrist_xjoint2"    polycoef="0 1 0 0 0" solref="0.002 0.5" solimp="0.95 0.98 0.001"/>
    <joint joint1="wrist_yjoint1"    joint2="wrist_yjoint2"    polycoef="0 1 0 0 0" solref="0.002 0.5" solimp="0.95 0.98 0.001"/>

    <!-- Coupling between elbow1 and elbow2 for IK (for forward kinematics, set values manually) -->
    <!-- ik start -->
    <joint joint1="elbow1_xjoint2" joint2="elbow2_xjoint1" polycoef="0 1 0 0 0" solref="0.01 1" solimp="0.95 0.98 0.001"/>
    <joint joint1="elbow1_yjoint2" joint2="elbow2_yjoint1" polycoef="0 1 0 0 0" solref="0.01 1" solimp="0.95 0.98 0.001"/>
	<!-- ik end -->

    <!-- Weld target and end-effector (EEF) sites for inverse kinematics -->
	<!-- ik start -->
    <weld body1="eef_body1" body2="target_body1" solref="0.05 0.5" solimp="0.95 0.99 0.001"/>
    <weld body1="eef_body2" body2="target_body2" solref="0.05 0.5" solimp="0.95 0.99 0.001"/>
    <weld body1="eef_body3" body2="target_body3" solref="0.05 0.5" solimp="0.95 0.99 0.001"/>
    <!-- ik end -->
	
	
	<!-- Inverse kinematics: weld elbow target and elbow with very loose coupling -->
	<!-- ik start -->
	<weld body1="elbow_target_body" body2="elbow1_end" solref="2 2" solimp="0.3 0.9 0.0005"/>
	<!-- ik end -->
</equality>

<tendon>
    <!-- Tendon set 1: shoulder -->
    <spatial name="tendon_x_1" width="0.001" rgba="1 .5 .5 1">
        <site site="sh_tendon_x_start_1"/>
