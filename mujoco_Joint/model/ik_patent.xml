                                                                            <site name="el2_tendon_y_end_4"         pos=" -0.0053 0.0198  0.0" size="0.005"/>


                                                                            <!--Connector between elbow2 and wrist-->
                                                                            <geom name="link_elbow2_wrist" type="capsule" fromto="0 0 0 0 0 0.107" size="0.01" rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>

                                                                            <!-- WRIST JOINT -->

                                                                            <body name="wristbase" pos="0 0 0.13"> <!-- 0.107 + 0.023 = 0.13 -->
                                                                                <geom name="wristframex" type="box" size=".003" fromto="-.035 0 -.023 .035 0 -.023" rgba="0 0 1 1" contype="0" conaffinity="0"/>
                                                                                <geom name="wristframey" type="box" size=".003" fromto="0 -.035 -.023 0 .035 -.023" rgba="0 0 1 1" contype="0" conaffinity="0"/>
                                                                            <!-- Seilanker wr (8 Startpunkte + 1* gripper) -->
