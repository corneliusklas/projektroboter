                                                            <site name="el2_tendon_y_start_1"   pos=" 0.0018  0.0204  -0.023" size="0.005 "/>
                                                            <site name="el2_tendon_y_start_2"   pos=" 0.0053  0.0198  -0.023" size="0.005 "/>
                                                            <site name="el2_tendon_y_start_3"   pos=" -0.0018 0.0204  -0.023" size="0.005 "/>
                                                            <site name="el2_tendon_y_start_4"   pos=" -0.0053 0.0198  -0.023" size="0.005 "/>


                                                            <body name="elbow2_xjoint1" pos="0 0 0">
                                                                <geom name="elbow2_xjoint1" type="box" size=".005" fromto="-.02 0 -.023 .02 0 -.023" rgba="1 0 0 1" contype="0" conaffinity="0"/>
                                                                <joint name="elbow2_xjoint1" type="hinge" axis="1 0 0" pos="0 0 -.023" damping="0.02" range="-0.7854 0.7854"/>
                                                                <body name="elbow2_yjoint1" pos="0 0 0">
                                                                    <geom name="elbow2_connector" type="box" size=".003" fromto="0 0 -.023 0 0 .023" rgba=".5 .5 .5 1" contype="0" conaffinity="0"/>
                                                                    <geom name="elbow2_yjoint1" type="box" size=".006" fromto="0 0.02 -.023 0 -0.02 -.023" rgba="0 1 0 1" contype="0" conaffinity="0"/>
                                                                    <joint name="elbow2_yjoint1" type="hinge" axis="0 1 0" pos="0 0 -.023" damping="0.02" range="-0.7854 0.7854"/>
                                                                    <geom name="elbow2_yjoint2" type="box" size=".006" fromto="0 0.02 .023 0 -0.02 .023" rgba="0 1 0 1" contype="0" conaffinity="0"/>
                                                                    <body name="elbow2_yjoint2" pos="0 0 0">
                                                                        <joint name="elbow2_yjoint2" type="hinge" axis="0 1 0" pos="0 0 .023" damping="0.02" range="-0.7854 0.7854"/>
                                                                        <geom name="elbow2_xjoint2" type="box" size=".005" fromto="-.02 0 .023 .02 0 .023" rgba="1 0 0 1" contype="0" conaffinity="0"/>
                                                                        <body name="elbow2_end" pos="0 0 .023">
                                                                            <geom name="elbow2_box" type="box" size=".01 .01 .01" rgba="1 1 1 .3" contype="0" conaffinity="0" mass="0"/>
                                                                            <joint name="elbow2_xjoint2" type="hinge" axis="1 0 0" pos="0 0 0" damping="0.02" range="-0.7854 0.7854"/>
                                                                            <geom name="elbow2framex_end" type="box" size=".003" fromto="-.035 0 0 .035 0 0" rgba="0 0 1 1" contype="0" conaffinity="0"/>
                                                                            <geom name="elbow2framey_end" type="box" size=".003" fromto="0 -.035 0 0 .035 0" rgba="0 0 1 1" contype="0" conaffinity="0"/>
                                                                            <!-- Seilanker el2 (8 Endpunkte + 1* gripper) -->
                                                                            <site name="el2_tendon_gripper_end"     pos=" -0.0186 -0.0087  0.0" size="0.005"/>
                                                                            <site name="el2_tendon_x_end_1"         pos=" 0.0204 -0.0018  0.0" size="0.005"/>
                                                                            <site name="el2_tendon_x_end_2"         pos=" 0.0198 -0.0053  0.0" size="0.005"/>
                                                                            <site name="el2_tendon_x_end_3"         pos=" 0.0204  0.0018  0.0" size="0.005"/>
