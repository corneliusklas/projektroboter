                                            <joint name="elbow1_xjoint1" type="hinge" axis="1 0 0" pos="0 0 -.023" damping="0.02" range="-0.7854 0.7854" />
                                            <body name="elbow1_yjoint1" pos="0 0 0">
                                                <geom name="elbow1_connector" type="box" size=".003" fromto="0 0 -.023 0 0 .023" rgba=".5 .5 .5 1" contype="0" conaffinity="0"/>
                                                <geom name="elbow1_yjoint1" type="box" size=".006" fromto="0 0.02 -.023 0 -0.02 -.023" rgba="0 1 0 1" contype="0" conaffinity="0"/>
                                                <joint name="elbow1_yjoint1" type="hinge" axis="0 1 0" pos="0 0 -.023" damping="0.02" range="-0.7854 0.7854"/>
                                                <geom name="elbow1_yjoint2" type="box" size=".006" fromto="0 0.02 .023 0 -0.02 .023" rgba="0 1 0 1" contype="0" conaffinity="0"/>
                                                <body name="elbow1_yjoint2" pos="0 0 0">
                                                    <joint name="elbow1_yjoint2" type="hinge" axis="0 1 0" pos="0 0 .023" damping="0.02" range="-0.7854 0.7854"/>
                                                    <geom name="elbow1_xjoint2" type="box" size=".005" fromto="-.02 0 .023 .02 0 .023" rgba="1 0 0 1" contype="0" conaffinity="0"/>
                                                    <body name="elbow1_end" pos="0 0 .023">
                                                        <geom name="elbow1_box" type="box" size=".01 .01 .01" rgba="1 1 1 .3" contype="0" conaffinity="0" mass="0"/>
                                                        <joint name="elbow1_xjoint2" type="hinge" axis="1 0 0" pos="0 0 0" damping="0.02" range="-0.7854 0.7854"/>
                                                        <geom name="elbow1framex_end" type="box" size=".003" fromto="-.035 0 0 .035 0 0" rgba="0 0 1 1" contype="0" conaffinity="0"/>
                                                        <geom name="elbow1framey_end" type="box" size=".003" fromto="0 -.035 0 0 .035 0" rgba="0 0 1 1" contype="0" conaffinity="0"/>
                                                        <!-- Seilanker el1 (8 Endpunkte + 1* gripper) -->
                                                        <site name="el1_tendon_gripper_end"     pos=" -0.0186 -0.0087  0.0" size="0.005"/>
                                                        <site name="el1_tendon_x_end_1"         pos=" 0.0204 -0.0018  0.0" size="0.005"/>
                                                        <site name="el1_tendon_x_end_2"         pos=" 0.0198 -0.0053  0.0" size="0.005"/>
                                                        <site name="el1_tendon_x_end_3"         pos=" 0.0204  0.0018  0.0" size="0.005"/>
                                                        <site name="el1_tendon_x_end_4"         pos=" 0.0198  0.0053  0.0" size="0.005"/>
                                                        <site name="el1_tendon_y_end_1"         pos=" 0.0018  0.0204  0.0" size="0.005"/>
                                                        <site name="el1_tendon_y_end_2"         pos=" 0.0053  0.0198  0.0" size="0.005"/>
                                                        <site name="el1_tendon_y_end_3"         pos=" -0.0018 0.0204  0.0" size="0.005"/>
                                                        <site name="el1_tendon_y_end_4"         pos=" -0.0053 0.0198  0.0" size="0.005"/>

                                                        <!--Connector between elbow1 and elbow2-->
                                                        <geom name="link_elbow1_elbow2" type="capsule" fromto="0 0 0 0 0 0.031" size="0.01" rgba="0.5 0.5 0.5 1" contype="0" conaffinity="0"/>
                                                        <site  name="elbow_site" pos="0 0 0.0155" size="0.01" rgba="0 1 1 1"/>
                                                        <!-- ELBOW JOINT 2 -->
                                                        <body name="elbow2base" pos="0 0 0.054"> <!-- 0.031+ 0.023 = 0.054 -->
                                                            <geom name="elbow2framex" type="box" size=".003" fromto="-.035 0 -.023 .035 0 -.023" rgba="0 0 1 1" contype="0" conaffinity="0"/>
                                                            <geom name="elbow2framey" type="box" size=".003" fromto="0 -.035 -.023 0 .035 -.023" rgba="0 0 1 1" contype="0" conaffinity="0"/>
                                                            <!-- Seilanker el2 (8 Startpunkte + 1* gripper) -->
                                                            <site name="el2_tendon_gripper"     pos=" -0.0186 -0.0087  -0.023" size="0.005 "/>
                                                            <site name="el2_tendon_x_start_1"   pos=" 0.0204 -0.0018  -0.023" size="0.005 "/>
                                                            <site name="el2_tendon_x_start_2"   pos=" 0.0198 -0.0053  -0.023" size="0.005 "/>
