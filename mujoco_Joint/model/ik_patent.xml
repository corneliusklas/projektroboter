                                <geom name="shoulder_xjoint2" type="box" size=".005" fromto="-.02 0 .023 .02 0 .023" rgba="1 0 0 1" contype="0" conaffinity="0"/>
                                <body name="shoulder_end" pos="0 0 .023">
                                    <geom name="shoulder_box" type="box" size=".01 .01 .01" rgba="1 1 1 .3" contype="0" conaffinity="0" mass="0"/>
                                    <joint name="shoulder_xjoint2" type="hinge" axis="1 0 0" pos="0 0 0" damping="0.02" range="-0.7854 0.7854"/>
                                    <geom name="endframex" type="box" size=".003" fromto="-.035 0 0 .035 0 0" rgba="0 0 1 1" contype="0" conaffinity="0"/>
                                    <geom name="endframey" type="box" size=".003" fromto="0 -.035 0 0 .035 0" rgba="0 0 1 1" contype="0" conaffinity="0"/>
                                    <!-- Seilanker (8 Endpunkte + 1* gripper) -->
                                    <site name="sh_tendon_gripper_end"     pos=" -0.0186 -0.0087  0.0" size="0.005"/>
                                    <site name="sh_tendon_x_end_1"         pos=" 0.0204 -0.0018  0.0" size="0.005"/>
                                    <site name="sh_tendon_x_end_2"         pos=" 0.0198 -0.0053  0.0" size="0.005"/>
                                    <site name="sh_tendon_x_end_3"         pos=" 0.0204  0.0018  0.0" size="0.005"/>
                                    <site name="sh_tendon_x_end_4"         pos=" 0.0198  0.0053  0.0" size="0.005"/>
                                    <site name="sh_tendon_y_end_1"         pos=" 0.0018  0.0204  0.0" size="0.005"/>
